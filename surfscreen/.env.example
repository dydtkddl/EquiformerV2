# Sample environment file for SurfScreen
# Copy to .env and modify as needed

# ============================================
# API Configuration
# ============================================
SURFSCREEN_API_KEY=your-secure-api-key-here
API_PORT=8000
LOG_LEVEL=INFO

# ============================================
# Dashboard Configuration
# ============================================
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# Redis Configuration
# ============================================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ============================================
# Storage Configuration
# ============================================
RESULTS_DIR=/data/results
UPLOADS_DIR=/data/uploads

# ============================================
# Calculator Configuration
# ============================================
DEFAULT_ENGINE=emt
DEFAULT_DEVICE=cpu

# MACE Configuration (if using MACE)
# MACE_MODEL=small
# MACE_DEVICE=cuda

# xTB Configuration (if using xTB)
# XTB_METHOD=GFN2-xTB
