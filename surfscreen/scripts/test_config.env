#!/bin/bash
###############################################################################
# Test Environment Configuration
# 
# Source this file before running tests:
#   source scripts/test_config.env
###############################################################################

# ============================================
# Paths
# ============================================
export SURFSCREEN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$SURFSCREEN_ROOT/src:${PYTHONPATH:-}"

# ============================================
# Test Settings
# ============================================
# Number of parallel test workers
export PARALLEL_WORKERS="${PARALLEL_WORKERS:-$(nproc 2>/dev/null || echo 8)}"

# Test timeout in seconds
export TEST_TIMEOUT=300

# Skip these test categories
export SKIP_SLOW_TESTS="${SKIP_SLOW_TESTS:-false}"
export SKIP_GPU_TESTS="${SKIP_GPU_TESTS:-false}"
export SKIP_NETWORK_TESTS="${SKIP_NETWORK_TESTS:-false}"

# ============================================
# API Settings
# ============================================
export SURFSCREEN_API_URL="${SURFSCREEN_API_URL:-http://localhost:8000}"
export SURFSCREEN_API_KEY="${SURFSCREEN_API_KEY:-test_api_key}"

# ============================================
# Database Settings (for testing)
# ============================================
export SURFSCREEN_DB_URL="${SURFSCREEN_DB_URL:-sqlite:///test_outputs/test.db}"

# ============================================
# Cache Settings
# ============================================
export SURFSCREEN_CACHE_TYPE="${SURFSCREEN_CACHE_TYPE:-memory}"
export SURFSCREEN_REDIS_URL="${SURFSCREEN_REDIS_URL:-redis://localhost:6379/1}"

# ============================================
# GPU Settings
# ============================================
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export MACE_DEVICE="${MACE_DEVICE:-cuda}"
export MACE_MODEL="${MACE_MODEL:-mace-mp-0}"
export TORCH_DTYPE="${TORCH_DTYPE:-float32}"

# ============================================
# Logging
# ============================================
export SURFSCREEN_LOG_LEVEL="${SURFSCREEN_LOG_LEVEL:-WARNING}"
export PYTEST_LOG_LEVEL="${PYTEST_LOG_LEVEL:-WARNING}"

# ============================================
# Test Output
# ============================================
export TEST_OUTPUT_DIR="$SURFSCREEN_ROOT/test_outputs"
mkdir -p "$TEST_OUTPUT_DIR"

echo "Test environment configured:"
echo "  SURFSCREEN_ROOT: $SURFSCREEN_ROOT"
echo "  PARALLEL_WORKERS: $PARALLEL_WORKERS"
echo "  CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
echo "  TEST_OUTPUT_DIR: $TEST_OUTPUT_DIR"
