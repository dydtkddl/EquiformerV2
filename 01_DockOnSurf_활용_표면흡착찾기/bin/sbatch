#!/bin/bash
# ============================================
# Fake sbatch - 로컬에서 즉시 실행
# DockOnSurf의 MACE 작업을 로컬에서 동기 실행
# ============================================

SCRIPT="$1"
shift

JOB_ID=$$
echo "Submitted batch job $JOB_ID"

if [ ! -f "$SCRIPT" ]; then
    echo "Error: Script not found: $SCRIPT"
    exit 1
fi

# 스크립트의 작업 디렉토리 추출 (cd 명령 찾기)
WORK_DIR=$(grep -m1 "^cd " "$SCRIPT" | awk '{print $2}')

if [ -n "$WORK_DIR" ] && [ -d "$WORK_DIR" ]; then
    echo "Running in: $WORK_DIR"
    cd "$WORK_DIR"
fi

# 스크립트 실행 (동기)
bash "$SCRIPT"
EXIT_CODE=$?

echo "Job $JOB_ID completed with exit code $EXIT_CODE"
exit $EXIT_CODE
