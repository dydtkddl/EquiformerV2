&GLOBAL
  PRINT_LEVEL LOW
  PROJECT_NAME surf_molecule
  RUN_TYPE GEO_OPT
&END GLOBAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 500
  &END GEO_OPT
&END MOTION
&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME /ccc/work/cont003/gen0609/marticar/data/cp2k/BASIS_MOLOPT
    POTENTIAL_FILE_NAME /ccc/work/cont003/gen0609/marticar/data/cp2k/GTH_POTENTIALS
    UKS
    PLUS_U_METHOD MULLIKEN_CHARGES
    CHARGE 0
    &SCF
      MAX_SCF 500
      EPS_SCF 1E-07
      SCF_GUESS RESTART
      CHOLESKY INVERSE
      &OUTER_SCF
        MAX_SCF 10
        EPS_SCF 1.0E-7
      &END OUTER_SCF
      &OT
        MINIMIZER CG
        LINESEARCH 3PNT
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &QS
      EPS_DEFAULT 1.0E-09
      MAP_CONSISTENT
      EXTRAPOLATION PS
      EXTRAPOLATION_ORDER 2
    &END QS
    &MGRID
      NGRIDS 5
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &XC
      &XC_GRID
        XC_SMOOTH_RHO NN50
        XC_DERIV NN50_SMOOTH
      &END XC_GRID
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          R_CUTOFF 10
          TYPE DFTD3
          PARAMETER_FILE_NAME /ccc/work/cont003/gen0609/marticar/data/cp2k/dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          CALCULATE_C9_TERM T
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
       A     1.5382200000000003E+01    0.0000000000000000E+00    0.0000000000000000E+00
       B    -7.6911000000000014E+00    1.3321380000000000E+01    0.0000000000000000E+00
       C     0.0000000000000000E+00    0.0000000000000000E+00    2.6937889999999999E+01
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME coord.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &KIND O1
      ELEMENT O
      BASIS_SET DZVP-MOLOPT-GTH-q6
      POTENTIAL GTH-PBE-q6
      &BS
        &ALPHA
          NEL +2
          L 1
          N 2
        &END ALPHA
        &BETA
          NEL +2
          L 1
          N 2
        &END BETA
      &END BS
    &END KIND
    &KIND Fe1
      ELEMENT Fe
      BASIS_SET DZVP-MOLOPT-SR-GTH-q16
      POTENTIAL GTH-PBE-q16
      &DFT_PLUS_U
        L 2
        U_MINUS_J [eV] 5.0
      &END DFT_PLUS_U
      &BS
        &ALPHA
          NEL +4 -2
          L 2 0
          N 3 4
        &END ALPHA
        &BETA
          NEL -6 -2
          L 2 0
          N 3 4
        &END BETA
      &END BS
    &END KIND
    &KIND Fe2
      ELEMENT Fe
      BASIS_SET DZVP-MOLOPT-SR-GTH-q16
      POTENTIAL GTH-PBE-q16
      &DFT_PLUS_U
        L 2
        U_MINUS_J [eV] 5.0
      &END DFT_PLUS_U
      &BS
        &ALPHA
          NEL -6 -2
          L 2 0
          N 3 4
        &END ALPHA
        &BETA
          NEL +4 -2
          L 2 0
          N 3 4
        &END BETA
      &END BS
    &END KIND
    &KIND N
      BASIS_SET DZVP-MOLOPT-GTH-q5
      POTENTIAL GTH-PBE-q5
    &END KIND
    &KIND H
       BASIS_SET DZVP-MOLOPT-GTH-q1
       POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND C
      BASIS_SET DZVP-MOLOPT-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND S
      BASIS_SET DZVP-MOLOPT-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND P
      BASIS_SET DZVP-MOLOPT-GTH-q5
      POTENTIAL GTH-PBE-q5
    &END KIND
    &KIND Cl
      BASIS_SET DZVP-MOLOPT-GTH-q7
      POTENTIAL GTH-PBE-q7
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
