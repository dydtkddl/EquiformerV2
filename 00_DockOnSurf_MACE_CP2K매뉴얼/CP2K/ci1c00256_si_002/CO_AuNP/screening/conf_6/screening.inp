&GLOBAL
  PRINT_LEVEL LOW
  PROJECT_NAME CO@AuNP_screening
  RUN_TYPE GEO_OPT
&END GLOBAL
&MOTION
  &GEO_OPT
    MAX_FORCE 0.01
    RMS_DR 1
    RMS_FORCE 1
    OPTIMIZER BFGS
    MAX_DR 1
    MAX_ITER 500
  &END GEO_OPT
&END MOTION
&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &SUBSYS
    &CELL
      B 0.0 30.0  0.0
      A 30.0  0.0  0.0
      C 0.0  0.0 30.0
    &END CELL
    &TOPOLOGY
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME coord.xyz
    &END TOPOLOGY
    &KIND N
      POTENTIAL GTH-PBE-q5
      BASIS_SET DZVP-MOLOPT-GTH-q5
    &END KIND
    &KIND H
      POTENTIAL GTH-PBE-q1
      BASIS_SET DZVP-MOLOPT-GTH-q1
    &END KIND
    &KIND O
      POTENTIAL GTH-PBE-q6
      BASIS_SET DZVP-MOLOPT-GTH-q6
    &END KIND
    &KIND C
      POTENTIAL GTH-PBE-q4
      BASIS_SET DZVP-MOLOPT-GTH-q4
    &END KIND
    &KIND S
      POTENTIAL GTH-PBE-q6
      BASIS_SET DZVP-MOLOPT-GTH-q6
    &END KIND
    &KIND P
      POTENTIAL GTH-PBE-q5
      BASIS_SET DZVP-MOLOPT-GTH-q5
    &END KIND
    &KIND Cl
      POTENTIAL GTH-PBE-q7
      BASIS_SET DZVP-MOLOPT-GTH-q7
    &END KIND
    &KIND Au
      POTENTIAL GTH-PBE-q11
      BASIS_SET DZVP-MOLOPT-SR-GTH
    &END KIND
  &END SUBSYS
  &DFT
    POTENTIAL_FILE_NAME /ccc/work/cont003/gen0609/marticar/data/cp2k/GTH_POTENTIALS
    CHARGE 0
    BASIS_SET_FILE_NAME /ccc/work/cont003/gen0609/marticar/data/cp2k/BASIS_MOLOPT
    &MGRID
      REL_CUTOFF 50
      NGRIDS 5
      CUTOFF 400
    &END MGRID
    &QS
      EXTRAPOLATION_ORDER 2
      MAP_CONSISTENT 
      EXTRAPOLATION PS
      EPS_DEFAULT 1.0E-09
    &END QS
    &XC
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          REFERENCE_FUNCTIONAL PBE
          R_CUTOFF 10
          PARAMETER_FILE_NAME /ccc/work/cont003/gen0609/marticar/data/cp2k/dftd3.dat
          CALCULATE_C9_TERM T
          TYPE DFTD3
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &XC_GRID
        XC_DERIV NN50_SMOOTH
        XC_SMOOTH_RHO NN50
      &END XC_GRID
    &END XC
    &SCF
      ADDED_MOS 38
      EPS_SCF 1.0E-5
      CHOLESKY INVERSE
      MAX_SCF 300
      SCF_GUESS RESTART
      &DIAGONALIZATION
        EPS_ADAPT 0.01
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        BETA 1.5
        ALPHA 0.1
        NBUFFER 8
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
    &END SCF
  &END DFT
&END FORCE_EVAL
