&GLOBAL
  PRINT_LEVEL LOW
  PROJECT_NAME molecule
  RUN_TYPE GEO_OPT
&END GLOBAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 500
  &END GEO_OPT
&END MOTION
&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME /ccc/work/cont003/gen0609/marticar/data/cp2k/BASIS_MOLOPT
    POTENTIAL_FILE_NAME /ccc/work/cont003/gen0609/marticar/data/cp2k/GTH_POTENTIALS
    CHARGE 0
    &SCF
      MAX_SCF 300
      SCF_GUESS RESTART 
      EPS_SCF 1.0E-7  # A remettre a 10-7 plus tard
      CHOLESKY INVERSE
      # ADDED_MOS 38  # This is the number of atoms in your system
      &DIAGONALIZATION
         ALGORITHM STANDARD
         EPS_ADAPT 0.01
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA   0.1
        BETA    1.5
        NBROYDEN  8
      &END
    &END SCF
    &QS
      EPS_DEFAULT 1.0E-09
      MAP_CONSISTENT
      EXTRAPOLATION PS
      EXTRAPOLATION_ORDER 2
    &END QS
    &MGRID
      NGRIDS 5
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &XC
      &XC_GRID
        XC_SMOOTH_RHO NN50
        XC_DERIV NN50_SMOOTH
      &END XC_GRID
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          R_CUTOFF 10
          TYPE DFTD3
          PARAMETER_FILE_NAME /ccc/work/cont003/gen0609/marticar/data/cp2k/dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          CALCULATE_C9_TERM T
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
       A     30.0  0.0  0.0
       B      0.0 30.0  0.0
       C      0.0  0.0 30.0
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME coord.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &KIND N
      BASIS_SET DZVP-MOLOPT-GTH-q5
      POTENTIAL GTH-PBE-q5
    &END KIND
    &KIND H
       BASIS_SET DZVP-MOLOPT-GTH-q1
       POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND C
      BASIS_SET DZVP-MOLOPT-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND S
      BASIS_SET DZVP-MOLOPT-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND P
      BASIS_SET DZVP-MOLOPT-GTH-q5
      POTENTIAL GTH-PBE-q5
    &END KIND
    &KIND Cl
      BASIS_SET DZVP-MOLOPT-GTH-q7
      POTENTIAL GTH-PBE-q7
    &END KIND
    &KIND Au
      BASIS_SET DZVP-MOLOPT-SR-GTH 
      POTENTIAL GTH-PBE-q11
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
