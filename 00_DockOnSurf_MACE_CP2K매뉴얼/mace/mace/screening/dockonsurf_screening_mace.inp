# Sample of DockOnSurf input file. The file format must be an INI file. 
# Input format on http://forge.cbp.ens-lyon.fr/redmine/projects/dockonsurf/wiki

[Global]
project_name = name 
run_type = screening
code = mace
batch_q_sys = slurm # sge 
subm_script = sub_mace.sh
model_mace = /PATH/mace.model

[Screening]
screen_inp_file = mace_input.yaml
surf_file = coord
select_magns = energy MOI
confs_per_magn = 1
adsorption_height = 3
set_angles = euler
sample_points_per_angle = 3
sites = 45, 52, 55, (55 52), (52 45), (45 1)  
molec_ctrs = 3 , 4, (3 4) 
h_donor = O
h_acceptor = O 
max_structures = 10


